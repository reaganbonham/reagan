import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
from scipy.optimize import curve_fit


df = pd.read_csv('noisy_curvefit_data.csv')
print(df)


print(df.shape)


rows, cols = df.shape
print(rows)
print(cols)


print(df.head())
print(df.tail())


print(df.columns.tolist())


plt.scatter(
    df['x'], df['y_noise_1'], color = 'gray', label = 'Noisy Data Level 1',
)
plt.xlabel = ('x')
plt.ylabel = ('y')
plt.title = ('x vs. y_noise_1')
plt.legend()

plt.show()





x = df['x'].values
y_noise_1 = df['y_noise_1'].values


def model(x, A, k):
    return A * np.exp(-k * x)

p0 = [1, 1]
popt, pcov = curve_fit(model, x, y_noise_1, p0=p0)

A_fit, k_fit = popt
print(f'Fit: y = {A_fit:.2f} * e^(-{k_fit:.2f} * x)')

residuals = y_noise_1 - model(x, A_fit, k_fit)
chi2 = np.sum(residuals**2)
dof = len(x) - len(popt)
chi2_reduced = chi2 /dof

plt.figure(figsize(8, 5))

sort_idx = np.argsort(x)
x_sorted = x[sort_idx]

plt.scatter(x, y_noise_1, color = 'gray', label = 'Noisy Data Lvl 1')



